# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatdesk?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Staff Authentication (JWT)
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-in-production-32-chars"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_SAME_SITE="lax" # "lax" | "strict" | "none"
COOKIE_SECURE="false"  # "true" in production

# Meta WhatsApp Cloud API Global Defaults / Fallbacks
META_WEBHOOK_VERIFY_TOKEN="chatdesk_wa_verify_token_secure"
META_APP_SECRET="meta_app_secret_replace_in_production"
META_API_VERSION="v21.0"
META_API_BASE_URL="https://graph.facebook.com"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_replace_with_paystack_secret_key"
PAYSTACK_WEBHOOK_SECRET="sk_test_replace_with_paystack_webhook_secret"

# Optional AI FAQ Layer
OPENAI_API_KEY=""
AI_FAQ_ENABLED="false"
